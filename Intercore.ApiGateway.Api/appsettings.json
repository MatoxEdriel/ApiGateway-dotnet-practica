{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "productos-route": {
        "ClusterId": "productos-cluster",
        "AuthorizationPolicy": "RequireValidToken",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5001"
          }
        }
      },
      "productos-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5002"
          }
        }
      }
    },
    "Jwt": {
      "Key": "TuSuperClaveSecretaQueDebeSerLarga12345!",
      "Issuer": "MiApiGateway",
      "Audience": "MisMicroservicios"
    },
    "kafkaConfig": {
      "Host": "localhost:9092"
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "AllowedHosts": "*"
  }
}
