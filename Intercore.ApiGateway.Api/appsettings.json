{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
    },
      "productos-route": {
        "ClusterId": "productos-cluster",
        "AuthorizationPolicy": "RequireValidToken", 
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      }
  },
    
    
  
  
  
  
  "kafkaConfig": {
    "Host": "localhost:9092"
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
